{
  "manifest_version": 3,
  "name": "رفيق المسلم",
  "version": "1.1.0",
  "description": "أذكار وقرآن وحديث ومواقيت صلاة.",
  "permissions": ["alarms", "storage", "geolocation", "scripting", "tabs"],
  "host_permissions": [
    "https://raw.githubusercontent.com/*",
    "https://api.aladhan.com/*",
    "https://alfurqan.online/*",
    "https://www.islamcan.com/*",
    "<all_urls>"
  ],
  "action": {
    "default_title": "رفيق المسلم",
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": { "128": "icon.png" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["toast.js"], "run_at": "document_idle" }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src https://raw.githubusercontent.com https://api.aladhan.com https://alfurqan.online; media-src 'self' https:"
  }
}
