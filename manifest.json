{
  "manifest_version": 3,
  "name": "أذكاري",
  "version": "1.0.0",
  "description": "إشعارات أذكار دورية بالفاصل الزمني الذي تختاره. تعمل على متصفحات WebExtension.",
  "permissions": [
    "alarms",
    "storage",
    "geolocation",
    "offscreen",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/*",
    "https://api.aladhan.com/*",
    "https://alfurqan.online/*",
    "https://www.islamcan.com/*",
    "<all_urls>"
  ],
  "action": {
    "default_title": "أذكاري",
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "icons": { "128": "icon.png" },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["toast.js"],
      "run_at": "document_idle"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src https://raw.githubusercontent.com https://api.aladhan.com https://alfurqan.online; media-src 'self' https:"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "azkari@example.com",
      "strict_min_version": "121.0"
    }
  }
}
